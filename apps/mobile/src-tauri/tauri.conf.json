{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistant",
  "version": "0.1.0",
  "identifier": "dev.local.assistant",
  "build": {"beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist"},
  "app": {"windows": [{"title": "Assistant", "width": 420, "height": 860, "minWidth": 320, "minHeight": 500}], "security": {"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"}},
  "bundle": {"active": false}
}
